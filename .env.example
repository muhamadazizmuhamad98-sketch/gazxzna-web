# لە ڕەگەزی پڕۆژەکە «npm run dev» بکە — Vite دوای ئامادەبوونی API لە پۆرت 3001 دەست پێ دەکات.
API_PORT=3001

# ئەگەر «کێشەی تۆڕ (404)» دەبینیت:
# ١) لە فۆڵدەری سەرەکی پڕۆژەکە (gazxanarebaz) npm run dev بکە — نەک تەنها vite لە client.
# ٢) لە وێبگەڕ بچۆ: http://127.0.0.1:3001/api/health — دەبێت {"ok":true} ببینیت.
# ٣) ئەگەر .env هەیە، API_PORT هەمان ژمارە بێت لەگەڵ سێرڤەر.

# ─── بەکارهێنەرەکان (Users) ───
# فۆرمات: username:password:role
# ڕۆڵەکان: admin (هەموو بەشەکان)، user (مامەڵەی ڕۆژانە و قەرز و مەسرەف)، tire (تەنها بەشی تایە)
ADMIN_USER=admin
ADMIN_PASS=admin123
USER_USER=user
USER_PASS=user123
TIRE_USER=tire
TIRE_PASS=tire123

# کلیلی JWT (دڵنیابە لە گۆڕین بۆ بەرهەمدەرایەتی)
JWT_SECRET=gazxana-secret-key-change-me

# تێپەڕەوشەی باکئەپ
BACKUP_SECRET=gazxana1234
