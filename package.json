{
  "name": "gazxana-web",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"cross-env PORT=3001 API_PORT=3001 node server/index.js\" \"npm run dev:client\"",
    "dev:server": "cross-env PORT=3001 API_PORT=3001 node server/index.js",
    "dev:client": "wait-on -t 60000 tcp:127.0.0.1:3001 && cross-env API_PORT=3001 npm run dev -w gazxana-client",
    "build": "npm run build -w gazxana-client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "wait-on": "^8.0.1"
  }
}
